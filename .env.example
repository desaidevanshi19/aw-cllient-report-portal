# Copy this to .env and fill in values before deploying

# SQLite path (Railway: set to /data/portal.db and mount a volume at /data)
DATABASE_URL=sqlite:///data/portal.db

# Comma-separated list of allowed origins for CORS (use * for open access during dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PORT is set automatically by Railway — do not add it here
